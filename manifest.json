{
  "manifest_version": 3,
  "name": "Xmate — Following Manager",
  "version": "1.0.0",
  "description": "List everyone you follow on X with full stats (last active, followers, following, tweets, created). Read-only, private, local.",
  "permissions": ["storage", "webRequest", "cookies", "unlimitedStorage"],
  "host_permissions": [
    "https://x.com/*",
    "https://*.x.com/*",
    "https://api.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://api.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xmate — Following Manager"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
